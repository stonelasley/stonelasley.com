<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>StoneLasley.AppHost</RootNamespace>
    <AssemblyName>StoneLasley.AppHost</AssemblyName>
    <UserSecretsId>stonelasley-apphost</UserSecretsId>
    <!-- Plain `dotnet run` is the one command; the Aspire CLI bundle is not needed. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Api.csproj" />
  </ItemGroup>

</Project>
