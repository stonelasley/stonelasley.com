{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stonelasley-data-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served from a custom route only (ADR 0003).
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stonelasley",
      // Placeholder until the preview and production databases are provisioned.
      // `--local` runs ignore it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Post images under content-hash keys; readers load them from the bucket's custom domain.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "stonelasley-images-local" }],
  // Vectorize and Workers AI have no local simulation, so local dev and tests bind them remotely, to the
  // dedicated ci index (one namespace per test run).
  "vectorize": [{ "binding": "VECTORS", "index_name": "posts-v1-ci", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  // Deployed environments. Each has its own D1 database and a custom domain the API reaches it on.
  "env": {
    "preview": {
      "name": "stonelasley-data-proxy-preview",
      "workers_dev": false,
      "routes": [{ "pattern": "data-preview.stonelasley.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stonelasley-preview",
          "database_id": "0fad15fd-6140-43be-bbcb-e8574fc0ebd9",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "stonelasley-images-preview" }],
      "vectorize": [{ "binding": "VECTORS", "index_name": "posts-v1-preview" }],
      "ai": { "binding": "AI" }
    },
    "production": {
      "name": "stonelasley-data-proxy",
      "workers_dev": false,
      "routes": [{ "pattern": "data.stonelasley.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stonelasley-prod",
          "database_id": "4721e4ee-b6c5-4dcc-8df7-d6c05c699e6a",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "stonelasley-images-prod" }],
      "vectorize": [{ "binding": "VECTORS", "index_name": "posts-v1-prod" }],
      "ai": { "binding": "AI" }
    }
  }
}
